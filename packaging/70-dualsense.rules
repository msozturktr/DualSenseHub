# DualSense Hub: let the logged-in user control DualSense LEDs and hidraw nodes.
# Sony DualSense (054C:0CE6) and DualSense Edge (054C:0DF2), over USB and Bluetooth.

# LED class devices exposed by hid_playstation (lightbar, player LEDs, mic LED).
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*:rgb:indicator", RUN+="/bin/sh -c 'chmod 0666 /sys%p/brightness /sys%p/multi_intensity'"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*:white:player-*", RUN+="/bin/sh -c 'chmod 0666 /sys%p/brightness'"
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*:*:mic", RUN+="/bin/sh -c 'chmod 0666 /sys%p/brightness'"

# hidraw nodes (USB and Bluetooth; the HID parent device name contains the VID:PID).
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"
