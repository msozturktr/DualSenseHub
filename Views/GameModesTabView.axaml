<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseHub.ViewModels"
             x:Class="DualSenseHub.Views.GameModesTabView"
             x:DataType="vm:GameModesViewModel">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="Oyun Modları" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Henüz kayıtlı bir oyun modu yok. Euro Truck Simulator 2 desteği (SCS telemetri) sonraki aşamada burada görünecek."
                   TextWrapping="Wrap" Opacity="0.75" IsVisible="{Binding IsEmpty}" />
    </StackPanel>
</UserControl>
